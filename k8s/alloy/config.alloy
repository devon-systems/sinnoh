discovery.kubernetes "slingshot" {
  role = "pod"

  namespaces {
    names = ["slingshot"]
  }

  selectors {
    role  = "pod"
    label = "app.kubernetes.io/name=slingshot"
  }
}

discovery.relabel "slingshot" {
  targets = discovery.kubernetes.slingshot.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Running"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "instance"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }

  rule {
    target_label = "cluster"
    replacement  = "sinnoh"
  }
}

prometheus.scrape "slingshot" {
  targets         = discovery.relabel.slingshot.output
  job_name        = "slingshot"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.slingshot.receiver]
}

prometheus.relabel "slingshot" {
  forward_to = [prometheus.remote_write.sinnoh.receiver]

  // The deployed DDSketch summaries collapse low percentiles.
  // Use their sum and count for means, and Traefik histograms for percentiles.
  rule {
    source_labels = ["quantile"]
    regex         = ".+"
    action        = "drop"
  }
}

discovery.kubernetes "nodes" {
  role = "node"
}

discovery.relabel "cadvisor" {
  targets = discovery.kubernetes.nodes.targets
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label = "node"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label = "instance"
  }
}

prometheus.scrape "cadvisor" {
  targets = discovery.relabel.cadvisor.output
  job_name = "cadvisor"
  scheme = "https"
  metrics_path = "/metrics/cadvisor"
  scrape_interval = "30s"
  authorization {
    credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  }
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
  forward_to = [prometheus.relabel.cadvisor.receiver]
}

prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.sinnoh.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up|scrape_.*|container_cpu_usage_seconds_total|container_cpu_cfs_periods_total|container_cpu_cfs_throttled_periods_total|container_memory_working_set_bytes|container_memory_rss|container_oom_events_total"
    action = "keep"
  }
}

prometheus.exporter.self "cluster" {}
discovery.relabel "alloy_self" {
  targets = prometheus.exporter.self.cluster.targets
  rule {
    target_label = "job"
    replacement = "alloy-kubernetes"
  }
  rule {
    target_label = "instance"
    replacement = "alloy"
  }
}
prometheus.scrape "alloy_self" {
  targets = discovery.relabel.alloy_self.output
  job_name = "alloy-kubernetes"
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.sinnoh.receiver]
}

prometheus.scrape "kube_state_metrics" {
  targets = [{__address__ = "kube-state-metrics.alloy-system.svc:8080"}]
  job_name = "kube-state-metrics"
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.sinnoh.receiver]
}

discovery.kubernetes "postgres" {
  role = "pod"
  namespaces {
    names = ["cnpg-system"]
  }
  selectors {
    role = "pod"
    label = "cnpg.io/cluster=pg-shared"
  }
}

discovery.relabel "postgres" {
  targets = discovery.kubernetes.postgres.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_number"]
    regex = "9187"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex = "Running"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label = "node"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "instance"
  }
}

prometheus.scrape "postgres" {
  targets = discovery.relabel.postgres.output
  job_name = "pg-shared"
  scrape_interval = "30s"
  forward_to = [prometheus.relabel.postgres.receiver]
}

prometheus.relabel "postgres" {
  forward_to = [prometheus.remote_write.sinnoh.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up|scrape_.*|cnpg_collector_up|cnpg_collector_last_collection_error|cnpg_pg_replication_in_recovery|cnpg_pg_replication_lag|cnpg_pg_replication_streaming_replicas|cnpg_pg_replication_is_wal_receiver_up|cnpg_backends_total|cnpg_pg_database_size_bytes|cnpg_pg_stat_archiver_(archived_count|failed_count|last_archived_time)|barman_cloud_cloudnative_pg_io_(last_failed_backup_timestamp|last_available_backup_timestamp|first_recoverability_point)"
    action = "keep"
  }
}

prometheus.remote_write "sinnoh" {
  external_labels = {cluster = "sinnoh"}
  endpoint {
    url = "http://10.254.0.3:3020/api/v1/write"
    remote_timeout = "30s"
    queue_config {
      capacity = 10000
      min_shards = 1
      max_shards = 2
      max_samples_per_send = 2000
      batch_send_deadline = "5s"
      min_backoff = "30ms"
      max_backoff = "5s"
      retry_on_http_429 = true
    }
  }
  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

discovery.kubernetes "traefik" {
  role = "pod"

  namespaces {
    names = ["kube-system"]
  }

  selectors {
    role  = "pod"
    label = "app.kubernetes.io/name=traefik"
  }
}

discovery.relabel "traefik_metrics" {
  targets = discovery.kubernetes.traefik.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Running"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "instance"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }

  rule {
    target_label = "cluster"
    replacement  = "sinnoh"
  }
}

prometheus.scrape "traefik" {
  targets         = discovery.relabel.traefik_metrics.output
  job_name        = "traefik"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.sinnoh.receiver]
}

discovery.kubernetes "logs" {
  role = "pod"
}

discovery.relabel "logs" {
  targets = discovery.kubernetes.logs.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label = "node"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label = "service_name"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    separator = "/"
    target_label = "job"
  }
}

loki.source.kubernetes "workloads" {
  targets = discovery.relabel.logs.output
  forward_to = [loki.process.workloads.receiver]
}

loki.source.kubernetes_events "cluster" {
  job_name = "kubernetes-events"
  log_format = "json"
  forward_to = [loki.process.workloads.receiver]
}

loki.process "workloads" {
  stage.static_labels {
    values = {cluster = "sinnoh"}
  }
  forward_to = [loki.process.redact.receiver]
}

loki.process "redact" {
  stage.replace {
    expression = `(?i)\b(?:x-plex-token|plexonlinetoken|access_token|refresh_token|api[_-]?key|password|client_secret|authorization)["' ]*(?:[:=]|%3[dDaA])\s*"((?:\\.|[^"\\])*)"`
    replace = "[REDACTED]"
  }
  stage.replace {
    expression = `(?i)\b(?:x-plex-token|plexonlinetoken|access_token|refresh_token|api[_-]?key|password|client_secret|authorization)["' ]*(?:[:=]|%3[dDaA])\s*'((?:\\.|[^'\\])*)'`
    replace = "[REDACTED]"
  }
  stage.replace {
    expression = `(?i)\b(?:x-plex-token|plexonlinetoken|access_token|refresh_token|api[_-]?key|password|client_secret|authorization)["' ]*(?:[:=]|%3[dDaA])\s*(?:bearer\s+|basic\s+)?([^&\s"'<>]+)`
    replace = "[REDACTED]"
  }
  forward_to = [loki.write.sinnoh.receiver]
}

loki.write "sinnoh" {
  endpoint {
    url = "http://10.254.0.3:3030/loki/api/v1/push"
    remote_timeout = "10s"
    min_backoff_period = "500ms"
    max_backoff_period = "5m"
    max_backoff_retries = 20
    retry_on_http_429 = true
  }
}

discovery.kubernetes "flux" {
  role = "pod"
  namespaces {
    names = ["flux-system"]
  }
}

discovery.relabel "flux" {
  targets = discovery.kubernetes.flux.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex = "http-prom"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex = "Running"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "instance"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "controller_namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label = "node"
  }
}

prometheus.scrape "flux" {
  targets = discovery.relabel.flux.output
  job_name = "flux"
  scrape_interval = "30s"
  forward_to = [prometheus.relabel.flux.receiver]
}

prometheus.relabel "flux" {
  forward_to = [prometheus.remote_write.sinnoh.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up|scrape_.*|gotk_reconcile_.*|controller_runtime_reconcile_.*|workqueue_.*"
    action = "keep"
  }
}
